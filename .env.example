# Nunca faça commit de chaves reais.
PYMETAUDIO_ACOUSTID_KEY=
PYMETAUDIO_DISCOGS_TOKEN=

# Confirmação local por idioma/letra (1/0). Requer o extra [lyrics].
PYMETAUDIO_LYRICS_CONFIRMATION=1
PYMETAUDIO_WHISPER_MODEL=small
PYMETAUDIO_WHISPER_DEVICE=cpu
PYMETAUDIO_WHISPER_COMPUTE_TYPE=int8

# Opcional: diretório de cache local.
# PYMETAUDIO_CACHE_DIR=C:\\Users\\SeuUsuario\\AppData\\Local\\PyMetaAudio\\Cache
